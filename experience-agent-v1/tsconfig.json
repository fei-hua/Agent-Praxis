{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "core/**/*.ts",
    "experience/**/*.ts",
    "agents/**/*.ts",
    "telemetry/**/*.ts",
    "benchmark/**/*.ts",
    "policies/**/*.ts",
    "tests/**/*.ts"
  ]
}
